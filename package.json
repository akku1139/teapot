{
  "name": "teapot-coding-agent",
  "version": "0.37.228",
  "description": "A lightweight, always-on multi-agent harness for AI coding agents",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "llm",
    "harness",
    "autonomous-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akku1139/teapot.git"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "teapot": "dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && pnpm typecheck:web && vite build",
    "build-server": "tsc -p tsconfig.json",
    "build-web": "vite build",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "cd frontend && tsc",
    "typecheck:scripts": "cd scripts && tsc",
    "typecheck:test": "cd test && tsc",
    "lint": "oxlint --type-aware src frontend test scripts",
    "lint:comments": "node scripts/find-stacked-comments.ts",
    "lint:comments:strict": "node scripts/find-stacked-comments.ts --strict",
    "start": "node dist/index.js",
    "dev": "node src/index.ts",
    "dev-web": "vite",
    "test": "node --test test/*.test.ts",
    "test:portable": "node scripts/run-portable-tests.ts",
    "test:clean": "node scripts/clean-test-tmp.ts --apply",
    "test:tmp": "node scripts/clean-test-tmp.ts",
    "release:wait": "node scripts/wait-npm-version.ts",
    "pre-release": "pnpm typecheck:server && pnpm typecheck:web && pnpm typecheck:scripts && pnpm typecheck:test && pnpm lint && pnpm build && pnpm test && pnpm test:portable && node scripts/smoke-web.ts",
    "lint:fast": "oxlint src frontend test scripts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/client": "^2.3.1",
    "@mozilla/readability": "^0.6.0",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.3",
    "happy-dom": "^20.14.5",
    "hono": "^4.13.13",
    "openai": "^7.30.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "shiki": "^4.5.0",
    "solid-js": "^2.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
