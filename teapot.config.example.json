{
  "port": 7788,
  "dataDir": ".teapot",
  "llm": {
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKey": "sk-or-...",
    "model": "your-provider/your-model"
  },
  "progressIntervalMs": 600000,
  "agents": [
    { "id": "alpha", "workspace": "workspaces/alpha" }
