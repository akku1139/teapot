{
  "port": 7788,
  "//dataDir": "defaults to ~/.local/share/teapot-coding-agent",
  "providers": {
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "sk-or-..."
    },
    "orcarouter": {
      "baseUrl": "https://api.orcarouter.ai/v1",
      "apiKey": "sk-orca-...",
      "model": "orcarouter/auto"
    },
    "openai": {
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "sk-...",
      "model": "gpt-4o-mini"
    },
    "local": {
      "baseUrl": "http://localhost:8080/v1",
      "apiKey": "llama.cpp",
      "model": "local"
    }
  },
  "defaultProvider": "openrouter",
  "//onError": "\"stop\" (default) or \"retry\" — retry backs off exponentially (retryDelayMs, doubling, max 10 min) and starts a fresh round after round-fatal API errors / runaway trips, so unattended agents ride out outages",
  "onError": "retry",
  "retryDelayMs": 60000,
  "progressIntervalMs": 600000,
  "//contextWindowTokens": "optional: model context window size — powers the usage gauge in the web UI",
  "contextWindowTokens": 200000,
  "agents": [
    { "id": "alpha", "workspace": "workspaces/alpha" },
    { "id": "beta", "workspace": "workspaces/beta", "provider": "local", "model": "local" },
    { "id": "gamma", "workspace": "workspaces/gamma", "provider": "openai" }
  ],
  "tasks": [
    { "id": "status-check", "agent": "alpha", "schedule": "every 30m", "forked": true, "prompt": "Briefly check the workspace state (git status, failing tests) and report via report_progress. Do not start large work." }
  ]
}
